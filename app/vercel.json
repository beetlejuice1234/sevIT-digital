{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/tts.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/tts",
      "dest": "/api/tts.js"
    },
    {
      "src": "/api/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ],
  "env": {
    "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_API_KEY",
    "GROQ_API_KEY": "YOUR_GROQ_API_KEY"
  }
}
